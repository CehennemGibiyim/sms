{
  "name": "enough-v2-desktop",
  "version": "1.0.0",
  "private": true,
  "description": "Enough V2 SMS panel — cross-platform desktop uygulaması (Windows / macOS / Linux)",
  "main": "main.cjs",
  "scripts": {
    "prepare:web": "cd ../web-panel && bun run build && bun run build:server",
    "dev": "electron .",
    "dist": "electron-builder",
    "dist:win": "electron-builder --win",
    "dist:mac": "electron-builder --mac",
    "dist:linux": "electron-builder --linux",
    "publish": "electron-builder --publish always",
    "release": "electron-builder --publish always"
  },
  "devDependencies": {
    "electron": "^33.2.1",
    "electron-builder": "^25.1.8"
  },
  "dependencies": {
    "electron-updater": "^6.3.9"
  },
  "build": {
    "appId": "com.cyrozer.enoughv2",
    "productName": "Enough V2 Panel",
    "directories": {
      "output": "release",
      "buildResources": "build"
    },
    "files": [
      "main.cjs",
      "package.json",
      "resources/**"
    ],
    "extraResources": [
      { "from": "../web-panel/dist", "to": "dist" },
      { "from": "../web-panel/server-dist", "to": "server" }
    ],
    "asar": true,
    "win": {
      "target": [{ "target": "nsis", "arch": ["x64", "arm64"] }]
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "deleteAppDataOnUninstall": false
    },
    "mac": {
      "category": "public.app-category.utilities",
      "target": [{ "target": "dmg", "arch": ["x64", "arm64"] }]
    },
    "linux": {
      "category": "Utility",
      "target": ["AppImage", "deb"]
    },
    "publish": {
      "provider": "generic",
      "url": "https://example.com/enough-updates/"
    }
  }
}